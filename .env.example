# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/splyt_dev

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_char_random_secret
JWT_REFRESH_SECRET=replace_with_different_at_least_32_char_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Stripe Issuing ───────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ─── Plaid ────────────────────────────────────────────────────────────────────
# Get from: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=replace_me
PLAID_SECRET=replace_me
PLAID_ENV=sandbox

# ─── Security ─────────────────────────────────────────────────────────────────
# Used to encrypt Plaid access tokens at rest. Generate with: openssl rand -hex 32
PLAID_TOKEN_ENCRYPTION_KEY=replace_with_at_least_32_char_random_secret
